{
  "name": "home-assistant.io",
  "description": "Home Assistant Website & Documentation",
  "version": "1.0.0",
  "devDependencies": {
    "remark": "^15.0.0",
    "remark-cli": "^12.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^9.0.0",
    "remark-lint-fenced-code-flag": "^4.0.0",
    "remark-lint-no-shell-dollars": "^4.0.0",
    "remark-lint-heading-increment": "^3.0.0",
    "remark-lint-heading-style": "^3.0.0",
    "remark-lint-unordered-list-marker-style": "^4.0.0",
    "remark-lint-ordered-list-marker-style": "^3.0.0",
    "remark-lint-ordered-list-marker-value": "^3.0.0",
    "remark-lint-prohibited-strings": "^3.0.0",
    "remark-lint-no-multiple-toplevel-headings": "^3.0.0",
    "remark-lint-no-duplicate-headings": "^4.0.0",
    "remark-lint-no-empty-sections": "^4.0.0",
    "remark-lint-no-heading-punctuation": "^4.0.0"
  },
  "resolutions": {
    "minimist": ">=1.2.5"
  },
  "scripts": {
    "markdown:lint": "remark --quiet --frail .",
    "textlint:all": "textlint source",
    "textlint": "textlint source/_docs source/_faq source/_integrations source/_dashboards source/_dashboards source/cloud source/getting-started source/hassio source/dashboards"
  }
}

