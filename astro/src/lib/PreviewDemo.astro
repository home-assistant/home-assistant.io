---
// Renders one fixture variant for the component browser and stage
// pages. A variant is a single instance (`props` and `slot`), or, with
// `rows`, a grid of instances: an array of rows, each an array of
// `{ props, slot }`. Grids suit small components with many variants,
// such as buttons, laid out like the sheets in the design file.
// `before` is HTML rendered ahead of the instance, for components that
// show nothing until something opens them, such as a dialog's button.
const { Component, variant } = Astro.props;
---

{
  variant.rows ? (
    <div class="grid">
      {variant.rows.map((row) => (
        <div class="row">
          {row.map(({ props, slot }) => (
            <Component {...(props ?? {})}>
              {slot && <Fragment set:html={slot} />}
            </Component>
          ))}
        </div>
      ))}
    </div>
  ) : (
    <>
      {variant.before && <div class="before" set:html={variant.before} />}
      <Component {...(variant.props ?? {})}>
        {variant.slot && <Fragment set:html={variant.slot} />}
      </Component>
    </>
  )
}

<style>
  .grid {
    display: grid;
    gap: 0.75rem;
    /* Stages have no padding of their own (full-width components sit
       edge to edge); a grid of small components gets some. */
    padding: 0.75rem 1rem;
  }
  .before {
    padding: 0.75rem 1rem;
  }
  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
</style>
