---
// The link-in-bio page, /bio/: what the "link in bio" on Home Assistant's
// social profiles points at. Everything on it comes from
// source/_data/bio.yml (see src/lib/bio.mjs for what it can say), the
// site's blog posts and release notes, and the newsletter editions
// `rake newsletter_data` downloads before the build.
//
// A standalone page on purpose: no site header, navigation or footer,
// which a page opened from a social profile doesn't want. It keeps the
// site's head (social tags, fonts, Plausible).
//
// Built from the site's components: a Card for each item of a feed,
// a Button for each curated link and an Icon for each social link. A
// feed with `livestream` also has a LivestreamCard on top: while the
// channel has a stream to show, it takes the large first place and the
// list's first item shows as a row.
//
// The page is static, so it is built showing what is live at build time.
// Items with `starts` or `ends` are also rendered, hidden, with their
// times, and the script at the end shows and hides them as time passes
// (see src/lib/bio-schedule.mjs). Without JavaScript the page stays as
// it was built.
import fs from "node:fs";
import path from "node:path";
import { getEntry } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import LivestreamCard from "../../components/LivestreamCard.astro";
import { loadPosts, resolve, socialLinks, validate, withHeroTaken } from "../../lib/bio.mjs";
import { fetchLivestreamAtBuild, resolveDisplayState } from "../../lib/livestream";
import { setting } from "../../lib/site.mjs";
import "../../styles/tokens.scss";

const root = path.resolve(process.cwd(), "..");
const config = (await getEntry("bio", "bio"))?.data;
validate(config);

const now = new Date();
const posts = loadPosts(path.join(root, "source/_posts"), now);

// Lists downloaded before the build, by file name. A missing file (a
// local build without the Rake data tasks) means no items, not an error.
const data = Object.fromEntries(
  Object.values(config.sources ?? {})
    .filter((source) => source.type === "data")
    .map((source) => {
      try {
        return [source.file, JSON.parse(fs.readFileSync(path.join(root, `source/_data/${source.file}.json`), "utf8"))];
      } catch {
        return [source.file, []];
      }
    }),
);

// A feed with a livestream card: the channel's stream as the page is
// built. When there is one to show, the card is built in the large first
// place, so the page looks the same before and without JavaScript.
const streams = {};
for (const slug of new Set(config.sections.map((section) => section.livestream).filter(Boolean))) {
  streams[slug] = await fetchLivestreamAtBuild(slug);
}
const hasStream = (slug) => ["live", "upcoming", "past"].includes(resolveDisplayState(streams[slug], now.getTime()));
const sections = resolve(config, posts, now, setting("url"), data).map((section) =>
  section.livestream && hasStream(section.livestream) ? withHeroTaken(section) : section,
);
const iso = (date) => (date ? date.toISOString() : undefined);
// What the script needs to show or hide an entry later.
const schedule = (entry) => ({
  hidden: entry.hidden,
  "data-key": entry.key,
  "data-url": entry.url,
  "data-source": entry.source,
  "data-rank": entry.rank || undefined,
  "data-cap": entry.cap ?? undefined,
  "data-pinned": entry.pinned || undefined,
  "data-fallback-for": entry.fallbackFor?.length ? entry.fallbackFor.join(" ") : undefined,
  "data-variant": entry.variant,
  "data-starts": iso(entry.starts),
  "data-ends": iso(entry.ends),
  "data-airs": iso(entry.airs),
  "data-note-after": entry.noteAfter ?? undefined,
});
const socials = socialLinks(config);
const name = setting("title");
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead description={config.tagline} />
  </head>
  <body class="bio-page">
    <main class="bio">
      <header class="header">
        {config.avatar && <img class="avatar" src={config.avatar} width="56" height="56" alt="" />}
        <h1 class="name">{name}</h1>
        {config.tagline && <p class="tagline">{config.tagline}</p>}
      </header>

      {
        sections.map((section, sectionIndex) =>
          section.type === "feed" ? (
            <section class="feed" hidden={section.hidden}>
              {section.title && <h2>{section.title}</h2>}
              {section.livestream && <LivestreamCard slug={section.livestream} info={streams[section.livestream]} class="hero-livestream" />}
              <ul class="list" data-schedule data-order={section.order} data-limit={section.limit} data-claims={section.claims || undefined} data-hero-taken={section.heroTaken ? "" : undefined}>
                {section.entries.map((tile) => {
                  const video = tile.kind === "video";
                  const tileIndex = section.tiles.indexOf(tile);
                  return (
                    <li {...schedule(tile)}>
                      <Card
                        href={tile.url}
                        title={tile.label}
                        meta={tile.note}
                        image={tile.image}
                        layout={video || tile.kind === "hero" ? "stacked" : "row"}
                        imageWidth={video ? undefined : 1200}
                        imageHeight={video ? undefined : 630}
                        tone={video ? "dark" : tile.featured ? "accent" : "default"}
                        eager={sectionIndex === 0 && tileIndex >= 0 && tileIndex < 2}
                        rel="noopener"
                        data-section={section.title ?? "links"}
                        data-source={tile.source}
                        data-label={tile.label}
                      >
                        {video && (
                          <svg slot="media" class="play" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                            <path
                              d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
                              fill="#f00"
                            />
                            <path d="M45 24 27 14v20Z" fill="#fff" />
                          </svg>
                        )}
                      </Card>
                    </li>
                  );
                })}
              </ul>
            </section>
          ) : (
            <section class="links" hidden={section.hidden}>
              {section.title && <h2>{section.title}</h2>}
              <ul class="list" data-schedule data-order={section.order}>
                {section.entries.map((tile) => (
                  <li {...schedule(tile)}>
                    <Button
                      class="link"
                      href={tile.url}
                      scheme={tile.featured ? "green" : "tertiary"}
                      icon
                      rel="noopener"
                      data-section={section.title ?? "links"}
                      data-source={tile.source}
                      data-label={tile.label}
                    >
                      {tile.label}
                    </Button>
                  </li>
                ))}
              </ul>
            </section>
          ),
        )
      }

      {
        socials.length > 0 && (
          <nav class="socials" aria-label="Home Assistant elsewhere">
            {socials.map((social) => (
              <a
                class="social"
                href={social.url}
                aria-label={social.label}
                title={social.label}
                rel="noopener"
                data-section="socials"
                data-source="curated"
                data-label={social.platform}
              >
                <Icon name={social.platform} />
              </a>
            ))}
          </nav>
        )
      }

      <footer class="footer">
        <a href="/">home-assistant.io</a> · An <a href="https://www.openhomefoundation.org/">Open Home Foundation</a> project
      </footer>
    </main>
  </body>
</html>

<script>
  // Shows and hides scheduled items by the same rule the build used, with
  // the website's own time rather than the visitor's clock, which can be
  // wrong or set on purpose. One HEAD request reads the server's time from
  // the response's Date header; from there the page counts with
  // performance.now(), which ignores the system clock and changes to it.
  // If the request fails, nothing changes: the page stays as it was built.
  // Runs on load and every minute after, so a page left open picks up a
  // livestream as it starts.
  import { isShowing, select } from "../../lib/bio-schedule.mjs";

  // The server's time, and the performance.now() it belongs to: the
  // middle of the request, when the server most likely wrote the header.
  // `no-store` skips the browser's cache, whose copy would carry an old
  // Date. The CDN (Cloudflare in front of Netlify) writes a fresh Date on
  // every response, even when it serves a cached page, so Date alone is
  // the time. Don't add Age: that's how long the CDN has held the page,
  // and adding it would put the clock ahead by up to the cache lifetime.
  async function serverTime(): Promise<{ time: number; at: number } | null> {
    try {
      const sent = performance.now();
      const response = await fetch(location.pathname, { method: "HEAD", cache: "no-store" });
      const received = performance.now();
      const date = Date.parse(response.headers.get("Date") ?? "");
      if (!response.ok || Number.isNaN(date)) return null;
      return { time: date, at: (sent + received) / 2 };
    } catch {
      return null;
    }
  }

  // The page's lists as the rule in bio-schedule.mjs reads them, in the
  // order the build passed them.
  const lists = [...document.querySelectorAll<HTMLElement>("[data-schedule]")]
    .map((list) => {
      const items = [...list.children] as HTMLElement[];
      return {
        list,
        items,
        order: Number(list.dataset.order),
        limit: Number(list.dataset.limit) || Infinity,
        claims: list.dataset.claims !== undefined,
        entries: items.map(({ dataset }) => ({
          key: dataset.key,
          url: dataset.url,
          source: dataset.source,
          rank: Number(dataset.rank) || 0,
          cap: Number(dataset.cap) || null,
          pinned: dataset.pinned !== undefined,
          fallbackFor: dataset.fallbackFor ? dataset.fallbackFor.split(" ") : [],
          variant: dataset.variant,
          starts: dataset.starts,
          ends: dataset.ends,
        })),
      };
    })
    .sort((a, b) => a.order - b.order);

  function update(now: number) {
    const picks = select(lists, now);
    lists.forEach(({ list, items, entries }, listIndex) => {
      const keys = picks[listIndex];
      const heroTaken = list.dataset.heroTaken !== undefined;
      items.forEach((item, index) => {
        item.hidden = !isShowing(entries[index], keys, heroTaken);
        // A video that has started says when it aired, not when it starts.
        const { airs, noteAfter } = item.dataset;
        const meta = item.querySelector(".meta");
        if (airs && noteAfter && meta && Date.parse(airs) <= now) meta.textContent = noteAfter;
      });
      const section = list.closest("section");
      if (section) section.hidden = keys.length === 0;
    });
  }

  // The website's time once it's known; the visitor's clock until then,
  // which only matters when something on the page is scheduled.
  let now = () => Date.now();

  // Most of the time nothing is scheduled, and there is nothing to check.
  if (document.querySelector("[data-starts], [data-ends]")) {
    serverTime().then((server) => {
      if (server === null) return;
      now = () => server.time + (performance.now() - server.at);
      update(now());
      setInterval(() => update(now()), 60 * 1000);
    });
  }

  // A livestream card with a stream to show takes the large first place:
  // its list's first item then shows as a row.
  document.addEventListener("livestream:state", (event) => {
    const card = event.target as HTMLElement;
    const list = card.closest("section")?.querySelector<HTMLElement>("[data-schedule]");
    if (!list) return;
    const showing = ["live", "upcoming", "past"].includes((event as CustomEvent<string>).detail);
    if (showing) list.dataset.heroTaken = "";
    else delete list.dataset.heroTaken;
    update(now());
  });
</script>

<style lang="scss" is:global>
  body.bio-page {
    margin: 0;
    min-height: 100vh;
    background: var(--color-page);
    color: var(--color-text);
    font-family: var(--font-heading);
    -webkit-text-size-adjust: 100%;
  }
</style>

<style lang="scss">
  .bio {
    box-sizing: border-box;
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-xlarge) max(var(--space-large), env(safe-area-inset-right)) var(--space-xxlarge)
      max(var(--space-large), env(safe-area-inset-left));
  }

  .header {
    margin-bottom: var(--space-xlarge);
    text-align: center;
  }

  .avatar {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto var(--space-medium);
  }

  .name {
    margin: 0;
    font-size: var(--font-size-heading);
    font-weight: 600;
  }

  .tagline {
    max-width: 24rem;
    margin: var(--space-small) auto 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-large);
    text-wrap: balance;
  }

  h2 {
    margin: 0 0 var(--space-medium);
    font-size: var(--font-size-large);
    font-weight: 600;
  }

  // The feed sits on a light panel, so its white cards stand out.
  .feed {
    padding: var(--space-medium);
    background: var(--color-surface-subtle);
    border-radius: var(--radius-small);
  }

  .links {
    margin-top: var(--space-xlarge);
  }

  // The livestream card, when it shows, sits above the list in the
  // large first place, flat like the cards below it.
  .feed :global(.hero-livestream) {
    margin-bottom: var(--space-small);
    box-shadow: none;
  }

  .list {
    display: grid;
    gap: var(--space-small);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    width: 100%;
  }

  .play {
    width: 4.25rem;
    height: auto;
  }

  // A row of platform icons, each a 2.75rem tap target.
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-small);
    margin-top: var(--space-xxlarge);
  }

  .social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: #002e3e;
    font-size: var(--font-size-xxlarge);
    transition: color 0.2s ease;

    &:hover {
      color: #18bcf2;
    }

    &:focus-visible {
      box-shadow: inset 0 0 0 0.25rem #002e3e;
      outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .footer {
    margin-top: var(--space-xxlarge);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    text-align: center;

    a {
      color: inherit;
    }
  }
</style>
