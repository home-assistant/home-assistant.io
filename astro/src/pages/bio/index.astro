---
// The link-in-bio page, /bio/: what the "link in bio" on Home Assistant's
// social profiles points at. Everything on it comes from
// source/_data/bio.yml (see src/lib/bio.mjs for what it can say), the
// site's blog posts and release notes, and the newsletter editions
// `rake newsletter_data` downloads before the build.
//
// A standalone page on purpose: no site header, navigation or footer,
// which a page opened from a social profile doesn't want. It keeps the
// site's head (social tags, fonts, Plausible).
//
// Designed with the /community page's design system
// (sass/homeassistant/pages/community/): its light grey page, navy ink,
// Figtree type with tight headings, cyan panels, pill buttons with a
// white icon circle and the mint accent. Those colors are custom
// properties on <body> below, which the Bio* components read; spacing,
// type sizes and radii come from the site's tokens.
import fs from "node:fs";
import path from "node:path";
import { getEntry } from "astro:content";
import SiteHead from "../../components/SiteHead.astro";
import BioTile from "../../components/BioTile.astro";
import BioButton from "../../components/BioButton.astro";
import BioHero from "../../components/BioHero.astro";
import BioVideo from "../../components/BioVideo.astro";
import BioSocials from "../../components/BioSocials.astro";
import { loadPosts, resolve, socialLinks, validate } from "../../lib/bio.mjs";
import { setting } from "../../lib/site.mjs";
import "../../styles/tokens.scss";

const root = path.resolve(process.cwd(), "..");
const config = (await getEntry("bio", "bio"))?.data;
validate(config);

const now = new Date();
const posts = loadPosts(path.join(root, "source/_posts"), now);

// Lists downloaded before the build, by file name. A missing file (a
// local build without the Rake data tasks) means no items, not an error.
const data = Object.fromEntries(
  Object.values(config.sources ?? {})
    .filter((source) => source.type === "data")
    .map((source) => {
      try {
        return [source.file, JSON.parse(fs.readFileSync(path.join(root, `source/_data/${source.file}.json`), "utf8"))];
      } catch {
        return [source.file, []];
      }
    }),
);

const sections = resolve(config, posts, now, setting("url"), data);
const socials = socialLinks(config);
const name = setting("title");
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead description={config.tagline} />
  </head>
  <body class="bio-page">
    <main class="bio">
      <header class="header">
        {config.avatar && <img class="avatar" src={config.avatar} width="56" height="56" alt="" />}
        <h1 class="name">{name}</h1>
        {config.tagline && <p class="tagline">{config.tagline}</p>}
      </header>

      {
        sections.map((section, sectionIndex) =>
          section.type === "feed" ? (
            <section class="feed">
              {section.title && <h2 class="feed-title">{section.title}</h2>}
              <ul class="tiles">
                {section.tiles.map((tile, tileIndex) => {
                  const props = { ...tile, section: section.title };
                  const eager = sectionIndex === 0 && tileIndex < 2;
                  return (
                    <li>
                      {tile.kind === "video" ? (
                        <BioVideo {...props} eager={eager} />
                      ) : tile.kind === "hero" ? (
                        <BioHero {...props} />
                      ) : (
                        <BioTile {...props} eager={eager} />
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ) : (
            <section class="links">
              {section.title && <h2 class="links-title">{section.title}</h2>}
              <ul class="buttons">
                {section.tiles.map((tile) => (
                  <li>
                    <BioButton {...tile} section={section.title} />
                  </li>
                ))}
              </ul>
            </section>
          ),
        )
      }

      <div class="socials">
        <BioSocials links={socials} />
      </div>

      <footer class="footer">
        <a href="/">home-assistant.io</a> · An <a href="https://www.openhomefoundation.org/">Open Home Foundation</a> project
      </footer>
    </main>
  </body>
</html>

<style lang="scss" is:global>
  // The /community page's palette
  // (sass/homeassistant/pages/community/_variables.scss, _base.scss),
  // read by the Bio* components.
  body.bio-page {
    --bio-page-bg: #f5f6fa;
    --bio-ink: #002332;
    --bio-paragraph: #4f606e;
    --bio-primary: #00aef8;
    --bio-secondary: #16f3be;
    --bio-pill: #99dffc;
    --bio-panel: #cceffe;
    --bio-radius: 0.75rem;

    margin: 0;
    min-height: 100vh;
    background: var(--bio-page-bg);
    color: var(--bio-ink);
    font-family: var(--font-heading);
    line-height: 1.25;
    -webkit-text-size-adjust: 100%;
  }
</style>

<style lang="scss">
  .bio {
    box-sizing: border-box;
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-xlarge) max(var(--space-medium), env(safe-area-inset-right)) var(--space-xxlarge)
      max(var(--space-medium), env(safe-area-inset-left));
  }

  .header {
    margin-bottom: var(--space-xlarge);
    padding: 0 var(--space-small);
    text-align: center;
  }

  .avatar {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto var(--space-medium);
  }

  .name {
    margin: 0;
    font-size: var(--font-size-heading);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .tagline {
    max-width: 24rem;
    margin: var(--space-small) auto 0;
    color: var(--bio-paragraph);
    font-size: var(--font-size-large);
    text-wrap: balance;
  }

  // The feed sits in a cyan panel, like the community page's meetups and
  // newsletter sections.
  .feed {
    padding: var(--space-small);
    background: var(--bio-panel);
    border-radius: var(--bio-radius);
  }

  .feed-title {
    margin: var(--space-small) var(--space-small) var(--space-medium);
    font-size: var(--font-size-xxlarge);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .links {
    margin-top: var(--space-xlarge);
    padding: 0 var(--space-small);
  }

  .links-title {
    margin: 0 0 var(--space-medium);
    font-size: var(--font-size-medium);
    font-weight: 700;
  }

  .tiles,
  .buttons {
    display: grid;
    gap: var(--space-small);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials {
    margin-top: var(--space-xxlarge);
  }

  .footer {
    margin-top: var(--space-xxlarge);
    color: var(--bio-paragraph);
    font-size: var(--font-size-small);
    text-align: center;

    a {
      color: inherit;
    }
  }
</style>
