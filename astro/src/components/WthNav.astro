---
// The pill row under the site header, which jumps to the sections of the
// Month of "What the Heck?!" page.
//
// Replaces source/what-the-heck/components/_nav.html and the `#nav` and `.nav-pill`
// rules in sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same pills and targets; sizes from the theme.

import "../styles/tokens.scss";
import "../styles/wth.scss";
const links = [
  { href: "#moments", label: "What it is" },
  { href: "#everyone", label: "Who" },
  { href: "#how-it-works", label: "Tips" },
  { href: "#fix", label: "Fix a WTH" },
];
---

<nav id="nav" aria-label="On this page">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../styles/breakpoints";

  /* The row needs air on both sides: it sits between the site header above
     and the hero card below, and crowds both without it. */
  nav {
    padding-block: var(--space-xlarge);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-medium);
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    background-color: var(--wth-wash);
    border-radius: var(--radius-pill);
    color: var(--wth-ink);
    display: block;
    font-size: var(--font-size-medium);
    font-weight: 500;
    padding: var(--space-small) var(--space-large);
    text-decoration: none;
    transition: background-color 0.2s ease;
    white-space: nowrap;

    &:hover {
      background-color: var(--wth-mint);
    }

    &:focus-visible {
      outline: 3px solid var(--wth-focus);
      outline-offset: 3px;
    }
  }

  @media only screen and (min-width: breakpoints.$lap) {
    nav {
      padding-block: var(--space-xxlarge);
    }
  }
</style>
