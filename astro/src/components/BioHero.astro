---
// The first item of a `hero: true` feed on the link-in-bio page
// (/bio/): the item's social image across the top, then a larger
// title. Social images are 1200×630, so the image keeps that shape and
// the page doesn't move while it loads.
//
// Follows the /community page's design system (white card, rounded
// image, Figtree heading with the community page's tight tracking);
// page colors as in BioTile.astro.
import Icon from "./Icon.astro";
import "../styles/tokens.scss";

const { label, url, note, image, section, source } = Astro.props;
---

<a class="hero" href={url} rel="noopener" data-section={section ?? "links"} data-source={source} data-label={label}>
  <img class="image" src={image} width="1200" height="630" alt="" fetchpriority="high" decoding="async" />
  <span class="body">
    <span class="text">
      <span class="label">{label}</span>
      {note && <span class="note">{note}</span>}
    </span>
    <span class="arrow"><Icon name="arrow-right" /></span>
  </span>
</a>

<style lang="scss">
  .hero {
    box-sizing: border-box;
    display: block;
    padding: var(--space-small);
    background: var(--color-surface);
    border-radius: var(--bio-radius, 0.75rem);
    color: var(--bio-ink, #002332);
    font-family: var(--font-heading);
    text-decoration: none;
    transition: box-shadow 0.2s ease;

    &:hover {
      box-shadow: 0 0 0 2px var(--bio-primary, #00aef8);

      .arrow {
        background: var(--bio-primary, #00aef8);
        color: var(--color-text-inverse);
      }
    }

    &:focus-visible {
      outline: 3px solid var(--bio-ink, #002332);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    border-radius: var(--radius-small);
    object-fit: cover;
    background: var(--bio-panel, #cceffe);
  }

  .body {
    display: flex;
    align-items: center;
    gap: var(--space-medium);
    padding: var(--space-medium) var(--space-xsmall) var(--space-xsmall);
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .label {
    display: block;
    font-size: var(--font-size-xxlarge);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .note {
    display: block;
    margin-top: var(--space-small);
    color: var(--bio-paragraph, #4f606e);
    font-size: var(--font-size-small);
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--bio-panel, #cceffe);
    border-radius: 50%;
    font-size: var(--font-size-large);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
</style>
