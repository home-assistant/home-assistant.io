---
// "Four tips for a great WTH": how to write one that can be acted on.
import WthIcon from "./WthIcon.astro";
import { forumUrl } from "../lib/wth.mjs";
---

<section id="how-it-works">
  <div class="container">
    <div class="content">
      <h2>Four tips for a great WTH</h2>

      <ol class="rules">
        <li class="rule">
          <span class="rule-number">1</span>
          <h3>Check it’s not already there</h3>
          <p>If it is, there’s no need to post again.</p>
        </li>
        <li class="rule">
          <span class="rule-number">2</span>
          <h3>Share one at a time</h3>
          <p>So each can be discussed and followed on its own.</p>
        </li>
        <li class="rule">
          <span class="rule-number">3</span>
          <h3>Tell it like it is</h3>
          <p>Explain the problem, we’ll figure out the fix.</p>
        </li>
        <li class="rule">
          <span class="rule-number">4</span>
          <h3>Be kind</h3>
          <p>We’re all here because we care about Home Assistant, our homes and the people in them: that includes everyone on our forum!</p>
        </li>
      </ol>

      <div class="buttons-container">
        <a href={forumUrl} class="button primary" target="_blank" rel="noopener">
          Share your WTH
          <span class="icon-inline" aria-hidden="true"><WthIcon name="mdi:arrow-right" /></span>
        </a>
      </div>
    </div>
  </div>
</section>
