---
// "Four tips for a great WTH", on ink: how to write one that can be acted
// on.
//
// Replaces source/what-the-heck/components/_how.html and the `#how-it-works` rules in
// sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same tips and the same inverted band; the section's
// dark surface is now the shared section's `ink` tone rather than a block
// of per-element overrides.
import "../styles/tokens.scss";
import "../styles/wth.scss";
import WthSection from "./WthSection.astro";
import WthSteps from "./WthSteps.astro";
import WthButton from "./WthButton.astro";
import { forumUrl } from "../lib/wth.mjs";

const tips = [
  {
    title: "Check it’s not already there",
    text: "If it is, there’s no need to post again.",
  },
  {
    title: "Share one at a time",
    text: "So each can be discussed and followed on its own.",
  },
  {
    title: "Tell it like it is",
    text: "Explain the problem, we’ll figure out the fix.",
  },
  {
    title: "Be kind",
    text: "We’re all here because we care about Home Assistant, our homes and the people in them: that includes everyone on our forum!",
  },
];
---

<WthSection id="how-it-works" tone="ink" heading="Four tips for a great WTH">
  <WthSteps steps={tips} />
  <div class="actions">
    <WthButton href={forumUrl} external arrow>Share your WTH</WthButton>
  </div>
</WthSection>

<style lang="scss">
  .actions {
    margin-top: var(--space-xxlarge);
  }

  /* The usual hover turns the button ink, which would vanish on this band. */
  .actions :global(.button:hover) {
    background-color: var(--wth-on-ink);
    color: var(--wth-ink-base);
  }
</style>
