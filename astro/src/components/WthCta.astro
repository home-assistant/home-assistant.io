---
// The closing call to action.
import WthIcon from "./WthIcon.astro";
import WthCtaBackground from "./WthCtaBackground.astro";
import { forumUrl } from "../lib/wth.mjs";
---

<section id="cta">
  <div class="container">
    <div class="content">
      <div class="cta-card">
        <WthCtaBackground />

        <h2>So, what the heck?!</h2>
        <p>Whether you’ve run Home Assistant since the early days, installed it last week, or simply live with someone who won’t stop talking about it: this is <em>your</em> month!</p>
        <a class="button primary" href={forumUrl} target="_blank" rel="noopener">
          Share your WTH
          <span class="icon-inline" aria-hidden="true"><WthIcon name="mdi:arrow-right" /></span>
        </a>
      </div>
    </div>
  </div>
</section>
