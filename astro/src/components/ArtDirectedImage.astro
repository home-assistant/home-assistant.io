---
// A photo with an optional phone crop: `image` from the desk breakpoint
// (1140px), `mobileImage` below it, in one <picture>. Without a
// `mobileImage`, `image` is used at every width.
//
// Encodes at quality 85 by default, which keeps the detail in product
// photos (Astro's default is 80); `quality` raises it where a photo
// needs more, such as a hero exported as an already compressed WebP.
//
// Other attributes, such as `class`, go on the <picture>. The <img> is
// rendered here, so style it from the parent with :global(img).
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Image, getImage } from "astro:assets";
import { desk } from "../lib/breakpoints";

interface Props extends HTMLAttributes<"picture"> {
  image: ImageMetadata;
  mobileImage?: ImageMetadata;
  alt: string;
  // For `image`.
  widths: number[];
  sizes: string;
  // For `mobileImage`.
  mobileWidths?: number[];
  mobileSizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  // Encoding quality, 1 to 100.
  quality?: number;
}

const {
  image,
  mobileImage,
  alt,
  widths,
  sizes,
  mobileWidths = widths,
  mobileSizes = sizes,
  loading,
  fetchpriority,
  quality = 85,
  ...attrs
} = Astro.props;

const deskSet =
  mobileImage && (await getImage({ src: image, widths, quality }));
---

<picture {...attrs}>
  {
    deskSet && (
      <source media={desk} srcset={deskSet.srcSet.attribute} sizes={sizes} />
    )
  }
  <Image
    src={mobileImage ?? image}
    alt={alt}
    quality={quality}
    widths={mobileImage ? mobileWidths : widths}
    sizes={mobileImage ? mobileSizes : sizes}
    loading={loading}
    fetchpriority={fetchpriority}
  />
</picture>
