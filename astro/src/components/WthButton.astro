---
// A button on the Month of "What the Heck?!" page.
//
// Replaces the `.button` rules in sass/homeassistant/pages/wth/_base.scss,
// which exist mostly to undo the site's global button styling. Here there
// is nothing to undo: one pill, two variants, the arrow where the link
// leads off the page.
//
// Fidelity: revamp. Structure, variants and behavior are the Jekyll
// page's; sizes, spacing and the radius come from the theme.
import "../styles/tokens.scss";
import "../styles/wth.scss";
import WthIcon from "./WthIcon.astro";

interface Props {
  href: string;
  /** "hollow" is the outlined secondary button in the hero. */
  variant?: "primary" | "hollow";
  /** Opens in a new tab: every call to action pointing at the forum. */
  external?: boolean;
  /** The arrow that marks a link leading off the page. */
  arrow?: boolean;
}

const { href, variant = "primary", external = false, arrow = false } =
  Astro.props;
---

<a
  class:list={["button", variant]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
>
  <slot />
  {
    arrow && (
      <span class="arrow" aria-hidden="true">
        <WthIcon name="mdi:arrow-right" />
      </span>
    )
  }
</a>

<style lang="scss">
  .button {
    align-items: center;
    background-color: var(--wth-mint);
    border-radius: var(--radius-pill);
    color: var(--wth-ink);
    display: inline-flex;
    font-size: var(--font-size-large);
    font-weight: 600;
    gap: var(--space-small);
    line-height: 1.2;
    padding: var(--space-medium) var(--space-xlarge);
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;

    &:hover {
      background-color: var(--wth-ink);
      color: var(--wth-on-ink);
    }

    /* One focus ring for the whole page, outside the element, so a button
       that turns ink on hover still shows it against the section behind. */
    &:focus-visible {
      outline: 3px solid var(--wth-focus);
      outline-offset: 3px;
    }
  }

  .hollow {
    background-color: transparent;
    box-shadow: inset 0 0 0 1px var(--wth-ink);

    &:hover {
      background-color: var(--wth-ink);
      color: var(--wth-on-ink);
    }
  }

  .arrow {
    display: inline-flex;
    flex: none;
    font-size: var(--font-size-xlarge);
  }
</style>
