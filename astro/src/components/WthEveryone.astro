---
// "We want to hear from everyone": who the month is for, ending with
// the card of questions to ask the rest of the household.
import WthIcon from "./WthIcon.astro";
import { forumUrl } from "../lib/wth.mjs";
---

<section id="everyone">
  <div class="container">
    <div class="content">
      <h2>We want to hear from everyone</h2>

      <div class="audience-grid">
        <article class="audience-card">
          <span class="audience-icon" aria-hidden="true"><WthIcon name="mdi:star-four-points-outline" /></span>
          <h3>New to Home Assistant?</h3>
          <p>Post your “huh?” before you get used to it.</p>
        </article>
        <article class="audience-card">
          <span class="audience-icon" aria-hidden="true"><WthIcon name="mdi:sofa-outline" /></span>
          <h3>Don’t want to tinker, just want it to work?</h3>
          <p>Tell us where it doesn’t.</p>
        </article>
        <article class="audience-card">
          <span class="audience-icon" aria-hidden="true"><WthIcon name="mdi:home-heart" /></span>
          <h3>Living with someone else’s setup?</h3>
          <p>We hear from you least, and learn from you most.</p>
        </article>
        <article id="homework" class="audience-card homework-card">
          <div class="homework-intro">
            <span class="audience-icon" aria-hidden="true"><WthIcon name="mdi:account-group-outline" /></span>
            <h3>Get the whole home talking</h3>
            <p>Home Assistant should work for everyone, not just whoever set it up. Find out if it does with a little gentle questioning:</p>
          </div>

          <div class="homework-answers">
            <ul class="homework-questions">
              <li>What annoys you most about using Home Assistant?</li>
              <li>Where do you get lost in the app?</li>
              <li>When the house does something unexpected, do you know why?</li>
              <li>What would you change yourself, if you knew how?</li>
              <li>If you could change one thing, what would it be?</li>
            </ul>

            <p>Then help them share their answers in their own words as a WTH.</p>
            <a class="button primary" href={forumUrl} target="_blank" rel="noopener">
              Share now
              <span class="icon-inline" aria-hidden="true"><WthIcon name="mdi:arrow-right" /></span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
