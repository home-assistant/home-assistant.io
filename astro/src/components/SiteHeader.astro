---
// Site header: logo, version badge, main navigation with its
// dropdowns, the search mount point and the "Get started" call to
// action.
//
// Ports the structure and layout of the Jekyll header in
// `source/_includes/site/header.html` (placed by
// `source/_layouts/default.html`). The styling is a deliberate revamp
// rather than a copy: one link style for the whole navigation instead
// of the per-context underline, weight and wash treatments in
// `sass/homeassistant/base/_header.scss`,
// `sass/homeassistant/base/_navigation.scss` and the `.site-header`,
// `.menu` and `.docsearch` rules in `sass/homeassistant/_overrides.scss`.
//
// The Jekyll header now mirrors this one, so pages from both stacks
// look alike during the migration: same markup and class names in
// `source/_includes/site/header.html`, these styles ported to
// `sass/homeassistant/base/_header.scss` (which reads the tokens,
// breakpoints and container from src/styles/). Change both together.
//
// Four deliberate differences from the Jekyll markup, all agreed:
//   - The "Get started" call to action is the design system's Button
//     (primary, navy secondary on the dark header over the hero) in
//     sentence case, instead of the uppercase `.nav-cta` pill. It no
//     longer stays highlighted on the installation pages.
//   - Icons are inline SVGs (`<Icon>`, path data in src/lib/icons.ts)
//     instead of `<iconify-icon>` elements, so the header does not
//     depend on the Iconify CDN script.
//   - The DocSearch container is rendered empty, exactly as Jekyll
//     does; the page layout (Page.astro) loads and initializes
//     @docsearch/js against `#docsearch`, and the header reduces
//     DocSearch's button to the magnifier icon.
//   - The header does not position itself. On the live site the page
//     makes it `position: fixed` so content scrolls underneath; that
//     belongs to the page layout, not to the header.
//
// One behavior moves in from the page: right-clicking the logo opens
// the brand guidelines on the contributors website. Jekyll wires that up in
// `source/_includes/javascripts/scripts.html`; here the header's own
// script does it, so every page that renders the header gets it.
import "../styles/tokens.scss";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";
// Both logos come from the Open Home Foundation brand assets API and
// are downloaded into src/assets/brands/ when the build starts (see
// integrations/brand-assets.mjs and the list in astro.config.mjs).
import logoUrl from "../assets/brands/home-assistant-lockup-color-light.svg?url";
import logoInverseUrl from "../assets/brands/home-assistant-lockup-monochrome-dark.svg?url";

const {
  pathname = "",
  dark = false,
  version,
  versionUrl,
  releasedOn,
} = Astro.props;

// Jekyll marks an item active by comparing the first path segment.
const root = pathname.split("/")[1];

// The label needs a unique target: a page may hold more than one header.
const menuId = `site-menu-${crypto.randomUUID().slice(0, 8)}`;


type NavigationItem = {
  label: string;
  href: string;
  /** First path segments that mark the item active. */
  roots?: string[];
  items?: { label: string; href: string; icon?: IconName }[];
};

const navigation: NavigationItem[] = [
  {
    label: "Documentation",
    href: "/docs/",
    roots: ["docs", "dashboards", "voice_control", "common-tasks"],
    items: [
      { label: "Installation", href: "/installation/", icon: "home-assistant" },
      { label: "Automations", href: "/docs/automation/", icon: "robot-happy" },
      { label: "Dashboards", href: "/dashboards/", icon: "gauge" },
      {
        label: "Voice assistants",
        href: "/voice_control/",
        icon: "comment-processing-outline",
      },
      {
        label: "Device organization",
        href: "/docs/organizing/",
        icon: "view-grid",
      },
      {
        label: "Energy management",
        href: "/docs/energy/",
        icon: "solar-power-variant",
      },
      { label: "Templating", href: "/docs/templating/", icon: "code-braces" },
      {
        label: "Configuration using the YAML file",
        href: "/docs/configuration/",
        icon: "cog",
      },
    ],
  },
  {
    label: "Our hardware",
    href: "#",
    items: [
      { label: "Home Assistant Green", href: "/green/" },
      { label: "Connect ZBT-2", href: "/connect/zbt-2/" },
      { label: "Connect ZWA-2", href: "/connect/zwa-2/" },
      { label: "Voice Preview Edition", href: "/voice-pe/" },
    ],
  },
  { label: "Integrations", href: "/integrations/", roots: ["integrations"] },
  { label: "Blog", href: "/blog/", roots: ["blog"] },
  { label: "Need help?", href: "/help/", roots: ["help"] },
];

const versionTitle =
  version && releasedOn
    ? `Latest version ${version} released ${new Intl.DateTimeFormat("en-US", {
        dateStyle: "long",
        timeZone: "UTC",
      }).format(new Date(releasedOn))}`
    : undefined;
---

<header class:list={["site-header", { dark }]}>
  <div class="bar">
    <div class="brand">
      <a class="site-title" href="/">
        <img
          src={dark ? logoInverseUrl : logoUrl}
          alt="Home Assistant"
          width="1721"
          height="240"
        />
      </a>
      {
        version && (
          <a class="version" href={versionUrl} title={versionTitle}>
            {version}
          </a>
        )
      }
    </div>

    <nav aria-label="Main">
      <input
        class="menu-state"
        type="checkbox"
        id={menuId}
        aria-label="Main menu"
      />
      <label class="menu-button" for={menuId}>
        <span class="bars" aria-hidden="true"></span>
      </label>

      <ul class="menu">
        {
          navigation.map(({ label, href, roots, items }) => (
            <li>
              <a class:list={{ active: roots?.includes(root) }} href={href}>
                {label}
                {items && <Icon name="chevron-down" />}
              </a>
              {items && (
                <ul>
                  {items.map((item) => (
                    <li>
                      <a href={item.href}>
                        {item.icon && <Icon name={item.icon} />}
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }

        <li class="nav-search">
          {/* Filled in by @docsearch/js, which the page loads. */}
          <div class="docsearch" id="docsearch"></div>
        </li>

        <li class="nav-cta">
          {/* The secondary scheme in its on-dark colors over the
              homepage hero, where the primary cyan would blend into the
              hero's gradient. */}
          <Button
            href="/installation/"
            scheme={dark ? "secondary" : "primary"}
            onDark={dark}
            icon
          >
            Get started
          </Button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Right-clicking the logo leads to the brand guidelines instead of
  // opening the context menu, as on the live site.
  for (const logo of document.querySelectorAll(".site-header .site-title")) {
    logo.addEventListener("contextmenu", (event) => {
      event.preventDefault();
      location.assign(
        "https://contributors.home-assistant.io/brand/name-and-logo/",
      );
    });
  }
</script>

<style lang="scss">
  @use "../styles/breakpoints";
  @use "../styles/layout";

  /* Mobile first: the menu is a panel that drops out of the bar and is
     opened by the checkbox, which is what the Jekyll header does below
     1140px. The desktop bar is the media query at the bottom.

     Every link in the header — bar item, dropdown item, panel item —
     shares one style: current color, no decoration, a wash on hover
     and focus, the accent color when active. The three variables
     below are all the dark variant changes. */

  .site-header {
    --nav-color: var(--color-text);
    --nav-color-active: var(--color-link);
    --nav-wash: var(--color-hover-wash);

    backdrop-filter: blur(1.5rem);
    background-color: var(--color-header-surface);
    color: var(--nav-color);
    font-family: var(--font-sans);
    position: relative;

    &.dark {
      backdrop-filter: none;
      background-color: transparent;
    }
  }

  .bar {
    align-items: center;
    display: flex;
    gap: var(--layout-gutter);
    height: var(--header-height);
    justify-content: space-between;
    @include layout.container;
  }

  /* Logo and version badge */

  /* On the narrowest phones the logo scales down (keeping its
     proportions) so the bar never overflows; the version badge and the
     menu button keep their size. */
  .brand {
    align-items: center;
    display: flex;
    gap: var(--space-small);
    min-width: 0;
    white-space: nowrap;
  }

  .site-title {
    min-width: 0;
  }

  .site-title img {
    display: block;
    height: auto;
    max-height: 2rem;
    max-width: 100%;
    width: auto;
  }

  /* A small tag beside the logo, nudged down to sit with the
     wordmark rather than dead center. */
  .version {
    background: var(--color-surface-subtle);
    border-radius: var(--radius-xsmall);
    color: var(--color-link);
    flex: none;
    font-size: var(--font-size-xsmall);
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    text-decoration: none;
    translate: 0 0.1875rem;
  }

  /* Menu button (the checkbox drives the panel, no JavaScript) */

  nav {
    align-items: center;
    display: flex;
  }

  .menu-state {
    height: 0;
    opacity: 0;
    position: absolute;
    width: 0;
  }

  .menu-button {
    align-items: center;
    background: var(--color-highlight);
    border-radius: 50%;
    color: var(--color-text-inverse);
    cursor: pointer;
    display: flex;
    height: 2rem;
    justify-content: center;
    user-select: none;
    width: 2rem;

    &:hover,
    .menu-state:focus-visible + & {
      background: var(--color-highlight-shade);
    }
  }

  /* Three bars: the span is the middle one, its pseudo-elements the
     outer two. Opening the menu fades the middle bar and turns the
     outer two into a cross. */
  .bars {
    --bar-gap: 0.3125rem;
    --bar-weight: 0.125rem;

    background: currentColor;
    height: var(--bar-weight);
    position: relative;
    transition: background-color 0.2s;
    width: 0.875rem;

    &::before,
    &::after {
      background: currentColor;
      content: "";
      height: var(--bar-weight);
      left: 0;
      position: absolute;
      transition: transform 0.2s;
      width: 100%;
    }

    &::before {
      transform: translateY(calc(var(--bar-gap) * -1));
    }

    &::after {
      transform: translateY(var(--bar-gap));
    }

    .menu-state:checked + .menu-button & {
      background-color: transparent;

      &::before {
        transform: rotate(45deg);
      }

      &::after {
        transform: rotate(-45deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      &,
      &::before,
      &::after {
        transition: none;
      }
    }
  }

  /* Menu panel */

  /* The panel scrolls on its own when it is taller than the screen:
     its height, padding included, stops at the visible area below the
     bar (dvh leaves out the space behind a mobile browser's toolbars),
     and scrolling past its end does not move the page behind it. */
  .menu {
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
    box-sizing: border-box;
    display: none;
    flex-wrap: wrap;
    left: 0;
    list-style: none;
    margin: 0;
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--layout-gutter) 0;
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 10;

    .menu-state:checked ~ & {
      display: flex;
    }

    li {
      width: 100%;
    }

    /* Submenus sit inline and stay open inside the panel. */
    ul {
      list-style: none;
      margin: 0 0 0 var(--layout-gutter);
      padding: 0;
    }

    /* Navigation links only: Astro also gives the call to action's
       Button root this component's scope, so a bare `a` would restyle it. */
    a:not(.button) {
      align-items: center;
      border-radius: var(--radius-small);
      color: inherit;
      display: flex;
      font-size: var(--font-size-medium);
      gap: var(--space-small);
      /* A whole-pixel line height keeps the bar's items, and the call
         to action's artwork, on the pixel grid. */
      line-height: 1rem;
      margin: 0 var(--layout-gutter);
      padding: var(--space-medium);
      text-decoration: none;
      transition: background-color 0.15s;

      &:hover,
      &:focus-visible {
        background: var(--nav-wash);
      }

      &.active {
        color: var(--nav-color-active);
      }
    }

    /* <Icon> renders in its own scope, hence :global. Limited to the
       navigation links: the call to action's Button has an `.icon` of
       its own (the arrow circle) that must keep its size. */
    a:not(.button) :global(.icon) {
      flex: none;
      height: var(--font-size-large);
      width: var(--font-size-large);
    }
  }

  /* Search and call to action lead the panel, side by side. The call
     to action goes first, with search beside it, reversing their
     desktop-bar DOM order — same as the live site. */

  /* Scoped under .menu to outrank the panel's full-width items. */
  .menu :is(.nav-cta, .nav-search) {
    width: auto;
  }

  .nav-cta {
    margin-left: var(--layout-gutter);
    order: -2;
  }

  .nav-search {
    order: -1;
  }

  /* DocSearch renders its button into the empty container; reduce it to
     the magnifier in the navigation color, as on the live site.
     The button is DocSearch's markup, hence :global. */
  .docsearch :global(.DocSearch-Button) {
    background: none;
    box-shadow: none;
    color: var(--nav-color);
    margin: 0;
    padding: var(--space-medium);
  }

  .docsearch :global(.DocSearch-Search-Icon) {
    color: inherit;
  }

  .docsearch :global(:is(.DocSearch-Button-Placeholder, .DocSearch-Button-Keys)) {
    display: none;
  }

  /* Desktop bar */

  @media only screen and (min-width: breakpoints.$desk) {
    .site-header.dark {
      --nav-color: var(--color-text-inverse);
      --nav-color-active: var(--color-text-inverse);
      --nav-wash: var(--color-hover-wash-inverse);
    }

    /* The checkbox goes too, or keyboard focus would land on it. */
    .menu-state,
    .menu-button {
      display: none;
    }

    .menu {
      align-items: center;
      background: none;
      box-shadow: none;
      display: flex;
      max-height: none;
      flex-wrap: nowrap;
      overflow: visible;
      padding: 0;
      position: static;

      a:not(.button) {
        margin: 0;
      }

      > li {
        display: flex;
        position: relative;
        width: auto;
      }

      > li > a {
        white-space: nowrap;
      }

      /* Dropdowns: hover for pointers, focus-within for keyboards. */
      /* The dropdown panel is light even in the dark header, so it
         takes back the light navigation colors. */
      > li > ul {
        --nav-color-active: var(--color-link);
        --nav-wash: var(--color-hover-wash);

        background: var(--color-surface);
        border-radius: var(--radius-small);
        box-shadow: var(--shadow-panel);
        color: var(--color-text);
        display: none;
        flex-direction: column;
        left: 0;
        margin: 0;
        padding: var(--space-small);
        position: absolute;
        top: calc(100% + var(--space-small));
        /* Absolute boxes shrink to the item above them without this. */
        width: max-content;

        /* An invisible bridge over the gap above, so the pointer can
           cross it without leaving the item and closing the dropdown. */
        &::before {
          content: "";
          height: var(--space-small);
          left: 0;
          position: absolute;
          right: 0;
          top: calc(var(--space-small) * -1);
        }
      }

      > li:hover > ul,
      > li:focus-within > ul {
        display: flex;
      }
    }

    /* In the bar they follow the navigation instead of leading it. */
    .nav-cta,
    .nav-search {
      order: 0;
    }

    .nav-cta {
      margin-left: var(--space-small);
    }
  }

  /* Just above the desk breakpoint the bar has only a few pixels to
     spare, and a classic scrollbar takes those (media queries count it,
     the layout does not). Tighter link padding up to the wide breakpoint
     keeps it on one line. */
  @media only screen and (min-width: breakpoints.$desk) and (max-width: breakpoints.$desk-wide) {
    .menu > li > a:not(.button),
    .docsearch :global(.DocSearch-Button) {
      padding-inline: var(--space-small);
    }
  }
</style>
