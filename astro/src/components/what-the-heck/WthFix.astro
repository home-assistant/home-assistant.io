---
// "Happy with how things work?": the contributor path.
//
// Replaces source/what-the-heck/components/_fix.html and the `#fix` rules in
// sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same steps and copy, with the radii and type from the
// theme.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import WthSection from "./WthSection.astro";
import WthSteps from "./WthSteps.astro";
import Button from "../Button.astro";
import { forumUrl } from "../../lib/wth.mjs";

const steps = [
  { title: "Pick it", text: "Browse the WTHs and find one you can take on." },
  { title: "Claim it", text: "Reply so nobody builds the same thing twice." },
  {
    title: "Ship it",
    text: "Open a pull request and link it back to the WTH.",
  },
];
---

<WthSection
  id="fix"
  tone="inherit"
  heading="Happy with how things work?"
  lead="No need to feel left out! If you’re comfortable with code, fix someone else’s WTH. Here’s how:"
>
  <WthSteps steps={steps} columnWidth="13rem" />

  <p class="note">
    New to contributing? Our <a
      href="https://developers.home-assistant.io/docs/development_index/"
      >developer docs</a
    > walk you through it.
  </p>

  <div class="actions">
    <Button href={forumUrl} scheme="green" icon target="_blank" rel="noopener">
      Browse open WTHs
    </Button>
  </div>
</WthSection>

<style lang="scss">
  .note {
    color: var(--wth-ink-soft);
    font-size: var(--font-size-large);
    line-height: 1.55;
    margin: var(--space-xlarge) 0 0;

    a {
      color: var(--wth-link);
      text-decoration: underline;

      &:hover {
        color: var(--wth-ink);
      }
    }
  }

  .actions {
    margin-top: var(--space-xlarge);
  }
</style>
