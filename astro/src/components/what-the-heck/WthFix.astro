---
// "Happy with how things work?": the contributor path, followed by WTHs
// from past editions that someone picked up and shipped.
//
// Replaces source/what-the-heck/components/_fix.html and the `#fix` rules in
// sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same steps, quotes and copy. Each quote still reads
// like a merged pull request on GitHub — the merge icon, the WTH as the
// title, the release as the meta line — with the radii and type from the
// theme.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import WthSection from "./WthSection.astro";
import WthSteps from "./WthSteps.astro";
import Button from "../Button.astro";
import WthIcon from "./WthIcon.astro";
import { forumUrl } from "../../lib/wth.mjs";

const steps = [
  { title: "Pick it", text: "Browse the WTHs and find one you can take on." },
  { title: "Claim it", text: "Reply so nobody builds the same thing twice." },
  {
    title: "Ship it",
    text: "Open a pull request and link it back to the WTH.",
  },
];

// Every quote is a real forum topic that was picked up and built. The two
// from 2020 are in the "So, what was fixed?" list of the summing-up post
// and shipped in 0.115; each link goes to the release that shipped it.
const shipped = [
  {
    wth: "How the heck can I set this user picture?",
    release: "0.115",
    url: "/blog/2020/09/17/release-115/#person-image-upload",
  },
  {
    wth: "Why are all automations in one big list?",
    release: "2024.4",
    url: "/blog/2024/04/03/release-20244/#three-new-ways-to-organize",
  },
  {
    wth: "WTH can’t we drag and drop in the dashboard?",
    release: "2024.11",
    url: "/blog/2024/11/06/release-202411/#sections-dashboard-no-longer-experimental",
  },
  {
    wth: "What the heck turned my light on?",
    release: "0.115",
    url: "/blog/2020/09/17/release-115/#more-information-in-the-logbook-panel",
  },
];
---

<WthSection
  id="fix"
  tone="surface"
  heading="Happy with how things work?"
  lead="No need to feel left out! If you’re comfortable with code, fix someone else’s WTH. Here’s how:"
>
  <WthSteps steps={steps} columnWidth="13rem" />

  <p class="note">
    New to contributing? Our <a
      href="https://developers.home-assistant.io/docs/development_index/"
      >developer docs</a
    > walk you through it.
  </p>

  <div class="actions">
    <Button href={forumUrl} scheme="green" icon target="_blank" rel="noopener">
      Browse open WTHs
    </Button>
  </div>

  <h2 class="shipped-heading">Make a real difference!</h2>
  <p class="note tight">
    This isn’t just talk: the WTHs below were all picked up and built by our
    community. Every fix from past What the Heck?! months is <a
      href="https://github.com/search?q=org%3Ahome-assistant+label%3AWTH+is%3Apr&type=pullrequests"
      target="_blank"
      rel="noopener">tagged on GitHub</a
    >.
  </p>

  <ul class="shipped">
    {
      shipped.map((fix) => (
        <li>
          <figure>
            <span class="merged" aria-hidden="true">
              <WthIcon name="octicon:git-merge-16" />
            </span>
            <div>
              <blockquote>
                <a href={fix.url}>{fix.wth}</a>
              </blockquote>
              <figcaption>
                Released in <span class="release">{fix.release}</span>
              </figcaption>
            </div>
          </figure>
        </li>
      ))
    }
  </ul>
</WthSection>

<style lang="scss">
  @use "../../styles/breakpoints";

  .note {
    color: var(--wth-ink-soft);
    font-size: var(--font-size-large);
    line-height: 1.55;
    margin: var(--space-xlarge) 0 0;

    a {
      color: var(--wth-link);
      text-decoration: underline;

      &:hover {
        color: var(--wth-ink);
      }
    }
  }

  .actions {
    margin-top: var(--space-xlarge);
  }

  /* The past fixes start a new block after the steps, under a heading that
     matches the section headings. */
  .shipped-heading {
    color: var(--wth-ink);
    font-size: var(--wth-font-size-heading);
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.1;
    margin: var(--wth-section-space) 0 0;
    padding-top: var(--space-xlarge);
    position: relative;

    &::before {
      background-color: var(--wth-mint);
      border-radius: 2px;
      content: "";
      height: 0.3125rem;
      left: 0;
      position: absolute;
      top: 0;
      width: 3.5rem;
    }
  }

  .tight {
    margin-top: var(--space-small);
  }

  .shipped {
    display: grid;
    gap: var(--space-large);
    /* At most two columns: the track takes half the row once there is
       room for two, and the whole row below that. */
    grid-template-columns: repeat(
      auto-fit,
      minmax(max(min(20rem, 100%), calc(50% - var(--space-large) / 2)), 1fr)
    );
    list-style: none;
    margin: var(--space-xxlarge) 0 0;
    padding: 0;
  }

  figure {
    align-items: flex-start;
    background-color: var(--wth-surface);
    border: 1px solid var(--wth-border);
    border-radius: var(--radius-small);
    display: flex;
    gap: var(--space-medium);
    margin: 0;
    padding: var(--space-large);
    position: relative;

    &:hover {
      border-color: var(--wth-link);

      a {
        color: var(--wth-link);
      }
    }
  }

  /* The merge icon sits on the first line of the title, as on GitHub. */
  .merged {
    color: var(--wth-merged);
    display: inline-flex;
    flex: none;
    font-size: var(--font-size-large);
    margin-top: 0.25rem;
  }

  blockquote {
    color: var(--wth-ink);
    font-size: var(--font-size-prose);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;

    /* The WTH is the link, and it covers the whole card. */
    a {
      color: inherit;
      text-decoration: none;

      &::after {
        border-radius: var(--radius-small);
        content: "";
        inset: 0;
        position: absolute;
      }

      &:focus-visible {
        outline: none;

        &::after {
          outline: 3px solid var(--wth-focus);
          outline-offset: 2px;
        }
      }
    }
  }

  figcaption {
    align-items: center;
    color: var(--wth-ink-soft);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--font-size-medium);
    gap: var(--space-xsmall);
    margin-top: var(--space-xsmall);
  }

  /* Matches the version badge beside the logo in the site header. */
  .release {
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-xsmall);
    color: var(--wth-link);
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.5;
    padding: 0 var(--space-xsmall);
  }

  @media only screen and (min-width: breakpoints.$lap) {
    .shipped {
      margin-top: var(--space-xxlarge);
    }
  }
</style>
