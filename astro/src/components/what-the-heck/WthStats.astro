---
// How many pull requests fix a WTH, as two big numbers and a link to the
// whole list on GitHub.
//
// Replaces source/what-the-heck/components/_stats.html and the `.wth-stats`
// rules in sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same copy and layout, with the type and spacing from
// the theme. Renders nothing without usable numbers, so a build that
// could not count them leaves no empty card behind.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import { parseWthStats } from "../../lib/wth-stats.mjs";

interface Props {
  /** The counters, as `loadWthStats` returns them. */
  stats?: ReturnType<typeof parseWthStats>;
}

const { stats } = Astro.props;
---

{
  stats && (
    <div class="stats">
      <p class="intro">
        {`Pull requests that fix a WTH${stats.sinceLabel ? `, since ${stats.sinceLabel}` : ""}.`}
      </p>
      <dl class="list">
        <div class="stat">
          <dt>Being worked on</dt>
          <dd>{stats.open}</dd>
        </div>
        <div class="stat">
          <dt>Shipped</dt>
          <dd>{stats.merged}</dd>
        </div>
      </dl>
      <a class="link" href={stats.url} target="_blank" rel="noopener">
        See them all on GitHub
      </a>
    </div>
  )
}

<style lang="scss">
  @use "../../styles/breakpoints";

  .stats {
    background-color: var(--wth-surface);
    border: 1px solid var(--wth-border);
    border-radius: var(--radius-large);
    margin-top: var(--space-xxlarge);
    padding: var(--space-xlarge);
  }

  .intro {
    color: var(--wth-ink-soft);
    font-size: var(--font-size-large);
    line-height: 1.55;
    margin: 0;
  }

  .list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-large) 3rem;
    margin: var(--space-large) 0 0;
  }

  /* The number reads first, the label under it. */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-xsmall);
  }

  dt {
    color: var(--wth-ink);
    font-size: var(--font-size-large);
    font-weight: 600;
    line-height: 1.3;
  }

  dd {
    color: var(--wth-number);
    font-size: clamp(2.75rem, 2rem + 2.4vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .link {
    color: var(--wth-link);
    display: inline-block;
    font-size: var(--font-size-large);
    margin-top: var(--space-xlarge);
    text-decoration: underline;

    &:hover {
      color: var(--wth-ink);
    }
  }

  @media only screen and (min-width: breakpoints.$lap) {
    .stats {
      padding: 1.75rem 2rem;
    }
  }
</style>
