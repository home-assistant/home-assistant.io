---
// The sea of WTHs in "What is a WTH": real WTHs from the forum drift along
// pipes as chat bubbles, one is picked out and brought to the front, and a
// reply pops up under it.
//
// Replaces the chat in source/what-the-heck/components/_what.html and its
// `#what-is-a-wth` rules in sass/homeassistant/pages/wth/_sections.scss.
// Both play from the same script, /javascripts/wth/wth-chat.js, which the
// page loads. The drifting is CSS; the script only picks. The first
// exchange is at the front in the markup, so without the script the chat
// shows that one, with the sea behind it.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import WthIcon from "./WthIcon.astro";
import WthSeaBackground from "./WthSeaBackground.astro";
import { statements as allStatements, replies as allReplies } from "../../lib/wth.mjs";

interface Props {
  /** The WTHs, in the order they play. */
  statements?: string[];
  /** The replies they take turns with: statement n gets reply n modulo
   *  their number. */
  replies?: string[];
}

const { statements = allStatements, replies = allReplies } = Astro.props;

// Four lanes, each holding its run twice so it loops without a seam. The
// bubbles leave off the "What the heck?!" every statement ends with.
const lanes = [0, 1, 2, 3].map((lane) => {
  const run = statements
    .map((statement, index) => ({ index, text: statement.replace(" What the heck?!", "") }))
    .filter(({ index }) => index % 4 === lane);
  return [...run, ...run];
});
---

<div
  class="chat"
  data-wth-chat
  role="region"
  aria-roledescription="carousel"
  aria-label="What the Heck?! examples"
>
  <div class="wth-sea">
    <WthSeaBackground />

    <div class="lanes" aria-hidden="true">
      {
        lanes.map((bubbles) => (
          <div class="lane">
            <div class="track">
              {bubbles.map(({ index, text }) => (
                <span class="wth-sea-bubble" data-index={index}>
                  {text}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <ol class="wth-chat-list" aria-live="polite">
      {
        statements.map((statement, i) => (
          <li
            class:list={["wth-chat-pair", i === 0 && "is-active is-replied"]}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${statements.length}`}
          >
            <p class="wth-chat-statement">{statement}</p>
            <p class="reply">
              <span class="dots" aria-hidden="true">
                <span />
                <span />
                <span />
              </span>
              <span class="reply-text">{replies[i % replies.length]}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="wth-chat-controls" hidden>
    <button type="button" class="button" data-wth-chat-prev aria-label="Previous">
      <span aria-hidden="true"><WthIcon name="mdi:chevron-left" /></span>
    </button>
    <button type="button" class="button" data-wth-chat-next aria-label="Next">
      <span aria-hidden="true"><WthIcon name="mdi:chevron-right" /></span>
    </button>
    <button type="button" class="button" data-wth-chat-toggle aria-label="Pause">
      <span class="pause" aria-hidden="true"><WthIcon name="mdi:pause" /></span>
      <span class="play" aria-hidden="true"><WthIcon name="mdi:play" /></span>
    </button>
  </div>
</div>

<style lang="scss">
  .chat {
    margin-top: var(--space-xxlarge);
  }

  /* A card like the hero's, with the same faint wash. */
  .wth-sea {
    background:
      linear-gradient(
        110deg,
        rgb(255 255 255 / 10%) 10%,
        rgb(24 188 242 / 10%) 55%,
        rgb(22 243 190 / 10%) 97%
      ),
      var(--wth-surface);
    border-radius: 0.75rem;
    height: 30rem;
    isolation: isolate;
    overflow: hidden;
    position: relative;

    /* A soft white glow behind the front bubble, so it reads clearly over
       the sea. */
    &::after {
      background: radial-gradient(
        ellipse 50% 45% at 50% 50%,
        rgb(255 255 255 / 90%) 30%,
        rgb(255 255 255 / 0%) 100%
      );
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
      z-index: 1;
    }
  }

  /* The lanes sit on the four long pipes in WthSeaBackground.astro, at 67,
     173, 307 and 413 of its 480. */
  .lane {
    inset-inline: 0;
    position: absolute;
    transform: translateY(-50%);

    &:nth-child(1) {
      top: 67px;
    }

    &:nth-child(2) {
      top: 173px;
    }

    &:nth-child(3) {
      top: 307px;
    }

    &:nth-child(4) {
      top: 413px;
    }

    /* Each lane drifts at its own pace, and every other one the other
       way. */
    &:nth-child(2) .track {
      animation-direction: reverse;
      animation-duration: 95s;
    }

    &:nth-child(3) .track {
      animation-duration: 80s;
    }

    &:nth-child(4) .track {
      animation-direction: reverse;
      animation-duration: 105s;
    }
  }

  /* Each track holds its lane's bubbles twice, so moving it by half its
     width loops without a seam. */
  .track {
    animation: drift 70s linear infinite;
    display: flex;
    gap: 3rem;
    padding-right: 3rem;
    width: max-content;
  }

  .is-paused .track,
  .is-offscreen .track {
    animation-play-state: paused;
  }

  .wth-sea-bubble {
    background-color: var(--wth-surface);
    border: 1px solid var(--wth-border);
    border-radius: 1rem 1rem 1rem 0.25rem;
    box-shadow: 0 4px 12px rgb(30 33 38 / 6%);
    color: var(--wth-ink-soft);
    font-size: var(--font-size-medium);
    font-weight: 500;
    line-height: 1.3;
    padding: 0.625rem 0.875rem;
    transition: opacity 0.3s ease;
    white-space: nowrap;

    &.is-picked {
      opacity: 0;
    }
  }

  /* The front: the picked WTH and its reply, centered over the sea. */
  .wth-chat-list {
    display: grid;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: var(--space-xlarge) var(--space-large);
    place-items: center;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .wth-chat-pair {
    display: flex;
    flex-direction: column;
    gap: var(--space-medium);
    grid-area: 1 / 1;
    max-width: 35rem;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
    visibility: hidden;
    width: 100%;

    &.is-active {
      opacity: 1;
      visibility: visible;
    }
  }

  .wth-chat-statement {
    align-self: flex-start;
    background-color: var(--wth-surface);
    border: 1px solid var(--wth-border);
    border-radius: 1.5rem 1.5rem 1.5rem 0.375rem;
    box-shadow: 0 16px 40px rgb(30 33 38 / 14%);
    color: var(--wth-ink);
    font-size: clamp(1.125rem, 0.9rem + 0.8vw, 1.375rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    padding: clamp(1.125rem, 1rem + 0.4vw, 1.375rem) clamp(1.375rem, 1.2rem + 0.4vw, 1.625rem);
    /* The flight in from the sea scales from the bubble's corner. */
    transform-origin: 0 0;
  }

  .reply {
    align-self: flex-end;
    background-color: var(--wth-mint);
    border-radius: 1.25rem 1.25rem 0.375rem 1.25rem;
    box-shadow: 0 10px 24px rgb(5 107 81 / 18%);
    color: var(--wth-ink);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.125rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    padding: var(--space-medium) 1.125rem;
    transform-origin: 100% 100%;
    visibility: hidden;
  }

  .is-active.is-typing .reply,
  .is-active.is-replied .reply {
    visibility: visible;
  }

  .is-active.is-typing .reply {
    animation: pop 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .dots {
    display: none;
    gap: var(--space-xsmall);
    padding-block: 0.375rem;

    span {
      animation: dot 1s ease-in-out infinite;
      background-color: var(--wth-ink);
      border-radius: 50%;
      height: 0.5rem;
      opacity: 0.4;
      width: 0.5rem;

      &:nth-child(2) {
        animation-delay: 0.15s;
      }

      &:nth-child(3) {
        animation-delay: 0.3s;
      }
    }
  }

  .is-typing {
    .dots {
      display: inline-flex;
    }

    .reply-text {
      display: none;
    }
  }

  .wth-chat-controls {
    align-items: center;
    display: flex;
    gap: var(--space-small);
    justify-content: center;
    margin-top: 1.25rem;

    &[hidden] {
      display: none;
    }
  }

  .button {
    align-items: center;
    background-color: var(--wth-surface);
    border: 1px solid var(--wth-border);
    border-radius: 50%;
    color: var(--wth-ink);
    cursor: pointer;
    display: inline-flex;
    font-size: var(--font-size-xlarge);
    height: 2.5rem;
    justify-content: center;
    padding: 0;
    transition: border-color 0.1s ease;
    width: 2.5rem;

    &:hover {
      border-color: var(--wth-ink);
    }

    &:focus-visible {
      outline: 3px solid var(--wth-focus);
      outline-offset: 2px;
    }

    &[hidden] {
      display: none;
    }
  }

  .play,
  .is-paused .pause {
    display: none;
  }

  .is-paused .play {
    display: inline;
  }

  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes dot {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }

    30% {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .is-active.is-typing .reply,
    .dots span {
      animation: none;
    }

    .wth-chat-pair,
    .wth-sea-bubble,
    .button {
      transition: none;
    }
  }
</style>
