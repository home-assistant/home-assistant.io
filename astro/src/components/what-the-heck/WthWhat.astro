---
// "What is a WTH": what the page is asking people for, on white like the
// hero above it, with real WTHs from the forum playing as a chat.
//
// Replaces source/what-the-heck/components/_what.html and the
// `#what-is-a-wth` rules in sass/homeassistant/pages/wth/_sections.scss.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import WthSection from "./WthSection.astro";
import WthChat from "./WthChat.astro";
import { fixesUrl } from "../../lib/wth.mjs";
---

<WthSection
  id="what-is-a-wth"
  tone="surface"
  heading="What is a WTH?"
  lead="Anything in Home Assistant that makes you go “What the heck?!” – whether you’ve used it for years or installed it last week."
>
  <WthChat />

  <p class="note">
    All the fixes from past editions of What the Heck?! are <a
      href={fixesUrl}
      target="_blank"
      rel="noopener">tagged on GitHub</a
    >.
  </p>
</WthSection>

<style lang="scss">
  .note {
    color: var(--wth-ink-soft);
    font-size: var(--font-size-large);
    line-height: 1.55;
    margin: var(--space-xlarge) 0 0;

    a {
      color: var(--wth-link);
      text-decoration: underline;

      &:hover {
        color: var(--wth-ink);
      }
    }
  }
</style>
