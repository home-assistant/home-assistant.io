---
// "This year’s challenge": the wide card of questions to ask the rest of the
// household.
//
// Replaces source/what-the-heck/components/_everyone.html and the `#everyone` and
// `.homework-card` rules in sass/homeassistant/pages/wth/_sections.scss.
//
// Fidelity: revamp. Same card and copy; the sizes come from the theme.
import "../../styles/tokens.scss";
import "../../styles/wth.scss";
import WthSection from "./WthSection.astro";
import Button from "../Button.astro";
import { forumUrl } from "../../lib/wth.mjs";

const questions = [
  "What annoys you most about Home Assistant?",
  "Where do you get lost in the app?",
  "When our home does something unexpected, do you know why?",
  "What would you change yourself, if you knew how?",
];
---

<WthSection id="everyone" tone="surface" heading="This year’s challenge">
  <article id="homework" class="card household">
    <h3>Gather WTHs from the people you live with too. Ask them:</h3>

    <div class="answers">
      <ul class="questions">
        {questions.map((question) => <li>{question}</li>)}
      </ul>
      <p>
        Then help them share their answers in their own words. Unfiltered
        feedback is worth its weight in gold!
      </p>
      <Button href={forumUrl} scheme="green" icon target="_blank" rel="noopener">
        Share now
      </Button>
    </div>
  </article>
</WthSection>

<style lang="scss">
  .card {
    background-color: var(--color-footer-surface);
    border: 1px solid var(--wth-border);
    border-radius: var(--radius-large);
    padding: var(--space-xlarge);
  }

  h3 {
    color: var(--wth-ink);
    font-size: var(--font-size-xlarge);
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .household {
    display: grid;
    gap: var(--space-xxlarge);
    margin-top: var(--space-xxlarge);
  }

  .answers > p {
    color: var(--wth-ink-soft);
    font-size: var(--font-size-large);
    line-height: 1.55;
    margin: var(--space-xlarge) 0 0;
  }

  .questions {
    display: grid;
    gap: var(--space-medium);
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      border-bottom: 1px solid var(--wth-border);
      color: var(--wth-ink);
      font-size: var(--font-size-large);
      font-weight: 500;
      line-height: 1.55;
      padding-bottom: var(--space-medium);
      padding-left: var(--space-xlarge);
      position: relative;

      &::before {
        background-color: var(--wth-mint);
        border-radius: 50%;
        content: "";
        height: 0.625rem;
        left: 0;
        position: absolute;
        top: 0.5rem;
        width: 0.625rem;
      }

      &:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }
    }
  }

  .household :global(.button) {
    margin-top: var(--space-xlarge);
  }
</style>
