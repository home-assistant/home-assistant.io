---
// Centered heading and lead text that open a section of a Connect
// product page, white and muted gray on the page's black.
//
// Built from the "Paragraph" frames in the Figma file "Connect AUX-2"
// (desktop node 2116:3097, mobile node 2119:5307), not ported from
// Jekyll. The heading scales from 24px on phones to 44px
// (--font-size-section); the lead is 16px, 24px from the desk width.
// Figma's -1px and -2px letter spacing is one -0.04em.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="connect-section-header">
  <h2>{title}</h2>
  {Astro.slots.has("default") && <p><slot /></p>}
</header>

<style lang="scss">
  @use "../../../styles/breakpoints";

  .connect-section-header {
    font-family: var(--font-heading);
    text-align: center;
  }

  h2 {
    color: var(--color-text-inverse);
    font-size: var(--font-size-section);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    padding-block: var(--space-small);
  }

  p {
    color: var(--color-text-inverse-muted);
    font-size: var(--font-size-large);
    line-height: 1.2;
    margin: 0;
    padding-block: var(--space-xsmall);
  }

  @media only screen and (min-width: breakpoints.$connect-desk) {
    h2 {
      padding-block: var(--space-large);
    }

    p {
      font-size: var(--font-size-xxlarge);
      padding-block: var(--space-small);
    }
  }
</style>
