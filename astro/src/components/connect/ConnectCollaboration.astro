---
// "Every purchase supports the Open Home Foundation" banner of a
// Connect product page: "Brought to you by" with the Nabu Casa logo, a
// heading and a paragraph, beside a photo, on a light blue gradient.
// The heading and text are the slot, as the product pages word them
// slightly differently.
//
// Built from "Banner Big" in the Figma file "Connect AUX-2" (node
// 2002:31185). It replaces the per-page `#collaboration` section of
// the Jekyll Connect pages
// (`source/connect/*/components/_collaboration.html`), with the same
// structure. The photo stacks above the text on phones.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import nabuCasa from "../../assets/collaboration/nabu-casa-dark.svg";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
}

const { image, imageAlt } = Astro.props;
---

<section class="connect-collaboration">
  <Image
    quality={85}
    src={image}
    alt={imageAlt}
    widths={[486, 972, 1440, image.width]}
    sizes="(min-width: 71.25rem) 30rem, 100vw"
  />
  <div class="text">
    <p class="partner">
      Brought to you by
      <img
        src={nabuCasa.src}
        width={nabuCasa.width}
        height={nabuCasa.height}
        alt="Nabu Casa"
      />
    </p>
    <slot />
  </div>
</section>

<style lang="scss">
  @use "../../styles/breakpoints";

  .connect-collaboration {
    /* Figma's "Banner Big" fill (a gradient from #a0c4d8 to #a0c5d8,
       flat to the eye), the pale blue of the photo's background. */
    background: #a0c4d8;
    border-radius: var(--radius-medium);
    color: var(--color-ink);
    display: grid;
    font-family: var(--font-heading);
    overflow: hidden;

    > img {
      height: 14rem;
      object-fit: cover;
      object-position: left top;
      width: 100%;
    }
  }

  .text {
    padding: var(--space-xlarge);

    :global(h2),
    :global(h3) {
      font-size: var(--font-size-xxlarge);
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
      margin: 0;
      padding-block: var(--space-medium);
    }

    :global(p) {
      color: var(--color-ink-muted);
      font-size: var(--font-size-large);
      line-height: 1.2;
      margin: 0;
      padding-block: var(--space-xsmall);
    }

    /* Links in the text, such as Nabu Casa's website: navy and
       underlined, as the text has no other color to set them apart. */
    :global(a) {
      color: var(--color-ink);
      text-decoration: underline;
      text-underline-offset: 0.15em;

      &:hover {
        text-decoration-thickness: 2px;
      }
    }
  }

  .partner {
    align-items: center;
    display: flex;
    font-weight: 500;
    gap: var(--space-small);

    .text & {
      color: var(--color-ink);
      padding-block: var(--space-small);
    }

    img {
      height: 1.0625rem;
      width: auto;
    }
  }

  /* The photo on the left, 486px of the 1200px banner as in Figma,
     the text beside it. */
  @media only screen and (min-width: breakpoints.$desk) {
    .connect-collaboration {
      align-items: center;
      grid-template-columns: minmax(0, 486fr) minmax(0, 714fr);
      height: 20.625rem;

      > img {
        height: 100%;
      }
    }

    .text {
      max-width: 40.75rem;
      padding: var(--space-xxlarge) var(--space-xxlarge) var(--space-xxlarge) 0;

      :global(h2),
      :global(h3) {
        font-size: var(--font-size-heading);
      }
    }
  }
</style>
