---
// A feature of a Connect product: an icon in a Connect-blue ring, a
// title and a short description, on a dark card whose background and
// Connect-blue border fade out towards the bottom. A comet of light
// sweeps around the border on hover (src/lib/shimmer.ts). The icon sits
// above the text on phones and beside it from the desk width.
//
// Built from the "Card" frames in the Figma file "Connect AUX-2"
// (desktop node 2234:16581, mobile node 2119:5260), not ported from
// Jekyll.
//
// The fading border is the ZBT-2 page's (see
// src/styles/_fade-border.scss), fading from the top. On hover the ring
// around the icon turns white with the shimmer, and the icon bounces.
//
// `light` is the white variant for cards on a photo (node 2586:1443):
// navy text, a filled ring so the white icon shows, a plain white
// border and no shimmer.
//
// `large` is the variant of "Incredible audio" (nodes 2022:8454 and
// 2022:8461): a large blue line icon without a ring above a 28px title,
// at every width. The `media` slot adds an illustration below the text.
//
// Deliberate differences from the Figma file:
//   - The icons are still. In Figma they animate (the sound waves
//     pulse, the dots travel along the lines); to be added with the
//     rest of the page's motion.
//   - Spacing snaps to the theme: 20px card padding on phones is 24px,
//     the 6px gap on phones is 8px, and both sizes use the 16px radius
//     (Figma: 12px on phones).
import type { ImageMetadata } from "astro";
import "../../styles/shimmer.scss";

interface Props {
  // A 14px white line icon (src/assets/connect/icons/), or for `large`
  // cards a 53px wide blue one.
  icon: ImageMetadata;
  title: string;
  light?: boolean;
  large?: boolean;
}

const { icon, title, light = false, large = false } = Astro.props;
const Ring = large ? Fragment : "span";
---

<article
  class:list={["connect-feature-card", { light, large }]}
  data-shimmer={light ? undefined : "hover"}
>
  <Ring class={large ? undefined : "ring"}>
    <img src={icon.src} width={icon.width} height={icon.height} alt="" />
  </Ring>
  <div class="text">
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
  {Astro.slots.has("media") && <div class="media"><slot name="media" /></div>}
</article>

<script>
  import { initShimmer } from "../../lib/shimmer";

  initShimmer();
</script>

<style lang="scss">
  @use "../../styles/breakpoints";
  @use "../../styles/fade-border" as *;

  .connect-feature-card {
    background: linear-gradient(rgb(0 19 38 / 80%) 17%, rgb(0 0 0 / 80%));
    border-radius: var(--radius-medium);
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    gap: var(--space-small);
    padding: var(--space-medium) var(--space-xlarge);

    &:not(.light) {
      @include fade-border(180deg);
    }
  }

  .ring {
    align-items: center;
    border: 1px solid var(--color-connect-line);
    border-radius: 50%;
    box-sizing: border-box;
    display: flex;
    flex: none;
    height: 2rem;
    justify-content: center;
    transition: border-color 0.3s ease;
    width: 2rem;

    /* White with the shimmer, while the pointer is over the card. */
    .connect-feature-card:not(.light):hover > & {
      border-color: var(--color-text-inverse);
    }

    /* The icon bounces once as the pointer arrives. */
    @media (prefers-reduced-motion: no-preference) {
      .connect-feature-card:not(.light):hover > & img {
        animation: connect-icon-bounce 0.6s cubic-bezier(0.3, 0, 0.3, 1);
      }
    }
  }

  /* Up with a tilt, down past its place with a little squash, then a
     smaller hop that settles. */
  @keyframes connect-icon-bounce {
    0%,
    100% {
      transform: none;
    }

    30% {
      transform: translateY(-0.25rem) rotate(-10deg);
    }

    55% {
      transform: translateY(0.0625rem) rotate(6deg) scaleY(0.9);
    }

    75% {
      transform: translateY(-0.125rem) rotate(-3deg);
    }
  }

  h3,
  p {
    line-height: 1.2;
    margin: 0;
  }

  h3 {
    color: var(--color-text-inverse);
    font-size: var(--font-size-large);
    font-weight: 500;
    padding-block: var(--space-small);
  }

  p {
    color: var(--color-text-inverse-muted);
    font-size: var(--font-size-small);
    padding-block: var(--space-xsmall);
  }

  .light {
    background: linear-gradient(rgb(255 255 255 / 80%) 22%, rgb(255 255 255 / 64%));
    border: 1px solid var(--color-text-inverse);

    .ring {
      background: var(--color-connect-line);
    }

    h3 {
      color: var(--color-ink);
    }

    p {
      color: var(--color-ink-muted);
    }
  }

  .large {
    gap: 0;

    > img {
      height: auto;
      margin-bottom: var(--space-small);
      width: 2.5rem;
    }

    h3 {
      font-size: var(--font-size-xxlarge);
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
      padding-block: var(--space-medium);
    }

    p {
      font-size: var(--font-size-medium);
    }
  }

  .media {
    margin-top: var(--space-xlarge);
  }

  @media only screen and (min-width: breakpoints.$desk) {
    .connect-feature-card {
      flex-direction: row;
      gap: var(--space-medium);
      padding: var(--space-xlarge) var(--space-xxlarge);
    }

    .large {
      flex-direction: column;
      gap: 0;

      > img {
        width: 3.3125rem;
      }

      h3 {
        font-size: var(--font-size-heading);
      }

      p {
        font-size: var(--font-size-large);
      }
    }

    .ring {
      height: 2.5rem;
      width: 2.5rem;
    }

    h3 {
      font-size: var(--font-size-xlarge);
    }

    p {
      font-size: var(--font-size-large);
    }
  }
</style>
