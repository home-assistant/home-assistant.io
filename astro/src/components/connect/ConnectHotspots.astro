---
// A product photo with clickable "+" points on its features, each
// opening a card about that feature, joined to its point by a
// Connect-blue line. The default slot is the section's intro (label,
// heading, text), drawn over the photo's top left.
//
// Built from "Connect everything" in the Figma file "Connect AUX-2"
// (desktop node 2586:1425). The points port the Voice Preview
// Edition's feature toggles (`.feature-toggle.button-more` in
// `source/voice-pe/index.html`, styles in `source/voice-pe/styles.css`,
// behavior in `registerProductFeatureToggles()` in
// `source/voice-pe/script.js`) in the Figma file's Connect blue: a dot
// with a plus that turns into a white dot with a minus and a wide
// halo when selected.
//
// Deliberate differences, from the Voice PE page and the Figma file:
//   - One point is always selected, as in the Figma file, so a card is
//     always shown; selecting the selected point does nothing (Voice
//     PE closes its card).
//   - The connecting line is drawn by the script between the selected
//     point and its card, for every point; the Figma file only draws
//     it for the audio port.
//   - Below the desk width the photo is zoomed in on the product with
//     the card below it, and no line.
//     The Figma file's mobile frame shows a 3D model instead, which is
//     not built yet.
//   - Figma's "Click to rotate" button is left out until there is a
//     photo of the other side (or the 3D model) to rotate to.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ConnectFeatureCard from "./ConnectFeatureCard.astro";

interface Hotspot {
  id: string;
  // The feature's name for screen readers, such as "Audio port".
  label: string;
  // The point's center, in percent of the photo's width and height.
  x: number;
  y: number;
  icon: ImageMetadata;
  title: string;
  text: string;
}

interface Props {
  // Product photo at 1440 × 957 proportions, product in the middle.
  image: ImageMetadata;
  imageAlt: string;
  hotspots: Hotspot[];
  // The point selected at first; the first one by default.
  selected?: string;
}

const { image, imageAlt, hotspots, selected = hotspots[0].id } = Astro.props;
const uid = crypto.randomUUID().slice(0, 8);
---

<section class="connect-hotspots" data-connect-hotspots>
  <div class="intro"><slot /></div>

  <div class="stage">
    <div class="photo">
      <Image
        src={image}
        alt={imageAlt}
        widths={[960, 1920, image.width]}
        sizes="(min-width: 71.25rem) 100vw, 200vw"
      />
      <!-- Under the points, so the selected point covers its end. -->
      <svg class="connector" aria-hidden="true">
        <path />
        <circle r="8" />
      </svg>
      {
        hotspots.map(({ id, label, x, y }: Hotspot) => (
          <button
            type="button"
            class="hotspot"
            style={`--x: ${x}%; --y: ${y}%`}
            aria-label={label}
            aria-controls={`${uid}-${id}`}
            aria-pressed={id === selected ? "true" : "false"}
            data-hotspot={id}
          >
            <span class="plus" aria-hidden="true" />
          </button>
        ))
      }
    </div>
  </div>

  <div class="cards" aria-live="polite">
    {
      hotspots.map(({ id, icon, title, text }: Hotspot) => (
        <div id={`${uid}-${id}`} data-card={id} hidden={id !== selected}>
          <ConnectFeatureCard icon={icon} title={title} light>
            {text}
          </ConnectFeatureCard>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Select a point: press its button, show its card, and draw the line
  // from the point to the card's left edge (desk width and up; the line
  // is hidden below it).
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-connect-hotspots]",
  )) {
    const buttons = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-hotspot]"),
    ];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    const svg = root.querySelector<SVGSVGElement>(".connector")!;
    const path = svg.querySelector("path")!;
    const end = svg.querySelector("circle")!;

    const draw = () => {
      if (getComputedStyle(svg).display === "none") return;
      const button = buttons.find((b) => b.ariaPressed === "true");
      const card = cards.find((c) => !c.hidden);
      if (!button || !card) return;

      const box = root.getBoundingClientRect();
      const from = button.getBoundingClientRect();
      const to = card.getBoundingClientRect();
      const x1 = from.left + from.width / 2 - box.left;
      const y1 = from.top + from.height / 2 - box.top;
      const x2 = to.left - box.left;
      const y2 = to.top + to.height / 2 - box.top;

      // Across from the point, down (or up) just before the card, and
      // across into it, with rounded corners as in the Figma file.
      const turn = x2 - 36;
      const dy = y2 - y1;
      const r = Math.max(0, Math.min(27, Math.abs(dy) / 2, (turn - x1) / 2));
      const s = Math.sign(dy);
      path.setAttribute(
        "d",
        `M ${x1} ${y1} H ${turn - r} Q ${turn} ${y1} ${turn} ${y1 + s * r}` +
          ` V ${y2 - s * r} Q ${turn} ${y2} ${turn + r} ${y2} H ${x2}`,
      );
      end.setAttribute("cx", String(x2));
      end.setAttribute("cy", String(y2));
    };

    const select = (id: string) => {
      for (const button of buttons) {
        button.ariaPressed = String(button.dataset.hotspot === id);
      }
      for (const card of cards) card.hidden = card.dataset.card !== id;
      draw();
    };

    for (const button of buttons) {
      button.addEventListener("click", () => select(button.dataset.hotspot!));
    }
    new ResizeObserver(draw).observe(root);
  }
</script>

<style lang="scss">
  @use "../../styles/breakpoints";
  @use "../../styles/layout";

  .connect-hotspots {
    display: flex;
    flex-direction: column;
    gap: var(--space-xlarge);
    padding-bottom: var(--space-xxlarge);
    position: relative;
  }

  .intro,
  .cards {
    @include layout.container;
  }

  /* On phones: the photo zoomed in on the product, from 7% to 62% of
     its width and 30% to 85% of its height. */
  .stage {
    aspect-ratio: 1440 / 957;
    background: #000a3d;
    overflow: hidden;
    position: relative;
  }

  .photo {
    aspect-ratio: 1440 / 957;
    left: -12%;
    position: absolute;
    transform: translateY(-30%);
    width: 180%;

    img {
      display: block;
      height: 100%;
      width: 100%;
    }
  }

  /* The points: a Connect-blue dot with a white plus and a thin white
     halo; selected, a white dot with a blue minus and a wide halo. */
  .hotspot {
    background: var(--color-connect-line);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 50%);
    cursor: pointer;
    height: 1.5rem;
    left: var(--x);
    padding: 0;
    position: absolute;
    top: var(--y);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.25s ease-out,
      box-shadow 0.25s ease-out;
    width: 1.5rem;

    &:hover {
      box-shadow: 0 0 0 0.3125rem rgb(255 255 255 / 50%);
    }

    &:focus-visible {
      outline: 2px solid var(--color-text-inverse);
      outline-offset: 0.375rem;
    }

    &[aria-pressed="true"] {
      background: var(--color-text-inverse);
      box-shadow: 0 0 0 1.25rem rgb(255 255 255 / 50%);
      cursor: default;
      z-index: 1;
    }
  }

  .plus {
    height: 0.5rem;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease-out;
    width: 0.5rem;

    &::before,
    &::after {
      background: var(--color-text-inverse);
      content: "";
      left: 50%;
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
      transition:
        opacity 0.25s ease-out,
        background-color 0.25s ease-out;
    }

    &::before {
      height: 2px;
      width: 100%;
    }

    &::after {
      height: 100%;
      width: 2px;
    }

    /* Turned a quarter, the vertical bar becomes the minus. */
    [aria-pressed="true"] & {
      transform: translate(-50%, -50%) rotate(90deg);

      &::before {
        opacity: 0;
      }

      &::after {
        background: var(--color-connect-line);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hotspot,
    .plus,
    .plus::before,
    .plus::after {
      transition: none;
    }
  }

  .connector {
    display: none;
  }

  /* From the desk width: the photo fills the section at the Figma
     frame's proportions, the intro over its top left and the card
     centered on its right, joined to the selected point by the line. */
  @media only screen and (min-width: breakpoints.$desk) {
    .connect-hotspots {
      display: grid;
      padding-bottom: 0;
    }

    .intro,
    .stage,
    .cards {
      grid-area: 1 / 1;
    }

    .stage {
      aspect-ratio: 1440 / 957;
    }

    .photo {
      inset: 0;
      transform: none;
      width: 100%;
    }

    .intro,
    .cards {
      pointer-events: none;
      z-index: 1;

      > :global(*) {
        pointer-events: auto;
      }
    }

    .intro {
      align-self: start;
      padding-top: var(--space-xxxlarge);
    }

    .cards {
      align-self: center;
      display: flex;
      justify-content: flex-end;

      > div {
        width: 24rem;
      }
    }

    /* Spans the photo, which fills the section here, so the script's
       section coordinates are the line's. */
    .connector {
      display: block;
      fill: var(--color-connect-line);
      height: 100%;
      inset: 0;
      overflow: visible;
      pointer-events: none;
      position: absolute;
      width: 100%;

      path {
        fill: none;
        stroke: var(--color-connect-line);
        stroke-width: 3;
      }
    }
  }
</style>
