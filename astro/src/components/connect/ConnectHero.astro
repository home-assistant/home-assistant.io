---
// Hero of a Connect product page: a full-bleed product photo with the
// product bar (the `nav` slot, a ConnectNav) at its top, and at its
// bottom the tagline, the product name as the page's heading, the lead
// text and the collaboration badge.
//
// Built from the "Hero" frames in the Figma file "Connect AUX-2"
// (desktop node 2310:3581, mobile node 2310:3664), not ported from
// Jekyll. It replaces `source/connect/*/components/_hero.html` on the
// Jekyll Connect pages.
//
// Deliberate differences from the Figma file:
//   - Sizes snap to the theme: the hero type scales between Figma's
//     phone and desktop sizes (--font-size-hero and
//     --font-size-hero-product), and the 20px gaps are 24px.
//   - The "Designed and built by" credits are the site's collaboration
//     badge, as on the other product pages, not Figma's variant of it
//     (colon, smaller logos, 8% panel).
//   - The lead text lines up with the badge's text on desktop instead
//     of sitting 4px further in.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import CollaborationBadge from "../CollaborationBadge.astro";

interface Props {
  // Product photo, cropped wide enough for desktop and tall enough
  // for phones; it covers the hero around its upper middle.
  image: ImageMetadata;
  imageAlt: string;
  // The product name after "Home Assistant", such as "Connect AUX-2".
  product: string;
  // Tagline lines; the last one, the punchline, is bold.
  tagline: string[];
}

const { image, imageAlt, product, tagline } = Astro.props;
---

<header class="connect-hero">
  <Image
    class="photo"
    src={image}
    alt={imageAlt}
    widths={[640, 1280, 1920, image.width]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="content">
    <slot name="nav" />

    <div class="intro">
      <hgroup class="title">
        <p class="tagline">
          {tagline.map((line) => <span>{line}</span>)}
        </p>
        <h1>
          <strong>Home Assistant</strong>{" "}<span class="product">{product}</span>
        </h1>
      </hgroup>

      <div class="aside">
        <p class="lead"><slot /></p>
        <CollaborationBadge />
      </div>
    </div>
  </div>
</header>

<style lang="scss">
  @use "../../styles/breakpoints";
  @use "../../styles/layout";

  .connect-hero {
    color: var(--color-text-inverse);
    display: flex;
    isolation: isolate;
    min-height: 38.75rem;
    position: relative;

    /* Darkens the bottom of the photo under the text. */
    &::after {
      background: linear-gradient(transparent 37%, rgb(0 0 0 / 70%));
      content: "";
      inset: 0;
      position: absolute;
      z-index: -1;
    }
  }

  .photo {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: 50% 28%;
    position: absolute;
    width: 100%;
    z-index: -2;
  }

  .content {
    @include layout.container;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxlarge);
    padding-bottom: var(--space-xxlarge);
  }

  .title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    gap: var(--space-xlarge);
    margin: 0;

    p,
    h1 {
      line-height: 1.2;
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
  }

  .tagline {
    font-size: var(--font-size-hero);
    letter-spacing: -0.02em;

    span {
      display: block;
    }

    span:last-child {
      font-weight: 700;
    }
  }

  /* Figma's slight tightening keeps the name on one line on a 393px
     phone; the product name itself never breaks ("AUX-" / "2"). */
  h1 {
    font-size: var(--font-size-hero-product);
    font-weight: 400;
    letter-spacing: -0.01em;

    strong {
      font-weight: 600;
    }
  }

  .product {
    white-space: nowrap;
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-medium);
  }

  .lead {
    font-family: var(--font-heading);
    font-size: var(--font-size-large);
    line-height: 1.2;
    margin: 0;
  }

  @media only screen and (min-width: breakpoints.$desk) {
    .connect-hero {
      min-height: 51.25rem;

      &::after {
        background: linear-gradient(transparent 31%, rgb(0 0 0 / 50%));
      }
    }

    .intro {
      align-items: flex-end;
      flex-flow: row wrap;
      justify-content: space-between;
      padding-bottom: var(--space-xxxlarge);
    }

    .title {
      gap: var(--space-xxlarge);
    }

    .aside {
      gap: var(--space-xlarge);
    }

    /* The lead keeps Figma's 407px column; the badge sizes to its
       content, a little wider. */
    .lead {
      box-sizing: border-box;
      font-size: var(--font-size-xxlarge);
      max-width: 25.5rem;
      padding-inline: var(--space-xlarge);
    }
  }
</style>
