---
// Placeholder layout for the migration scaffold, with deliberately
// minimal styling so preview pages are comfortable to read. The real
// page chrome (header, navigation, footer, styles ported from
// `sass/`) lands in a later change and replaces all of this.
import "../styles/tokens.scss";

const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The Astro build is not the published website yet: keep every
         page out of search engines regardless of where it is served.
         Remove (or make conditional) at cutover, together with the
         noindex rules in _headers. -->
    <meta name="robots" content="noindex" />
    <script is:inline>
      // Netlify serves directory pages with and without a trailing
      // slash. Relative links only resolve correctly with one, so
      // normalize the address without a reload.
      if (!location.pathname.endsWith("/")) {
        history.replaceState(
          null,
          "",
          `${location.pathname}/${location.search}${location.hash}`,
        );
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Instrument+Sans:ital,wdth,wght@0,99,400..700;1,99,400..700&display=swap"
    />
  </head>
  <body>
    <div class="preview-notice">
      Astro build preview — this is not the live version of this page.
    </div>
    <main class={wide ? "wide" : undefined}>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    background: #fff;
    color: #1d2126;
    font-family:
      -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue",
      sans-serif;
    line-height: 1.6;
    margin: 0;
  }
  .preview-notice {
    background: #eef7fb;
    border-bottom: 1px solid #c8e4f2;
    color: #33566b;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    text-align: center;
  }
  main {
    margin: 0 auto;
    max-width: 46rem;
    padding: 1.5rem 1rem 4rem;
  }
  main.wide {
    /* The component browser: tiles track the window width so that
       components laid out with viewport media queries fit. */
    max-width: none;
  }
  h1,
  h2,
  h3,
  h4 {
    line-height: 1.25;
    margin: 1.6em 0 0.5em;
  }
  h1 {
    font-size: 1.9rem;
    margin-top: 0.5em;
  }
  h2 {
    font-size: 1.4rem;
  }
  h3 {
    font-size: 1.1rem;
  }
  a {
    color: #0b7ab0;
  }
  code {
    background: #f1f4f6;
    border-radius: 3px;
    font-size: 0.9em;
    padding: 0.1em 0.35em;
  }
  pre {
    background: #f1f4f6;
    border-radius: 6px;
    overflow-x: auto;
    padding: 0.75rem 1rem;
  }
  pre code {
    background: none;
    padding: 0;
  }
  img {
    max-width: 100%;
  }
  table {
    border-collapse: collapse;
  }
  th,
  td {
    border: 1px solid #d7dde2;
    padding: 0.35rem 0.6rem;
  }
</style>
