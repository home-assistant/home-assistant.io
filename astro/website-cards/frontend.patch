diff --git a/build-scripts/gulp/website-cards.js b/build-scripts/gulp/website-cards.js
new file mode 100644
index 0000000..69454ae
--- /dev/null
+++ b/build-scripts/gulp/website-cards.js
@@ -0,0 +1,83 @@
+// Build a small bundle that renders real dashboard cards on the Home Assistant
+// website, using mocked data instead of a Home Assistant server.
+
+import { execFileSync } from "child_process";
+import { deleteSync } from "del";
+import fs from "fs";
+import gulp from "gulp";
+import path from "path";
+import { createWorkflowLockTask } from "../output-lock.mjs";
+import env from "../env.cjs";
+import paths from "../paths.cjs";
+import "./clean.js";
+import "./gather-static.js";
+import "./gen-icons-json.js";
+import "./locale-data.js";
+import "./rspack.js";
+import "./translations.js";
+
+gulp.task(
+  "clean-website-cards",
+  gulp.parallel("clean-translations", async () =>
+    deleteSync([paths.websiteCards_output_root, paths.build_dir])
+  )
+);
+
+// The website only shows English cards, so drop the other languages' locale
+// data (used by Intl polyfills), then pack the output as an npm package the
+// website can install.
+gulp.task("pack-website-cards", async () => {
+  const root = paths.websiteCards_output_root;
+  const localeData = path.resolve(root, "static/locale-data");
+  for (const dir of fs.readdirSync(localeData)) {
+    for (const file of fs.readdirSync(path.resolve(localeData, dir))) {
+      if (!/^(en|add-all-tz)\.json$/.test(file)) {
+        fs.rmSync(path.resolve(localeData, dir, file));
+      }
+    }
+  }
+
+  // npm needs semver: 20260826.0 -> 20260826.0.0, 20260826.0.dev -> -dev.
+  const [release, dev] = env.version().split(".dev");
+  const version = `${release}.0${dev === undefined ? "" : "-dev"}`;
+
+  fs.writeFileSync(
+    path.resolve(root, "package.json"),
+    JSON.stringify(
+      {
+        name: "@home-assistant/website-cards",
+        version,
+        description:
+          "Home Assistant dashboard cards with mocked data, for the Home Assistant website",
+        license: "Apache-2.0",
+        repository: {
+          type: "git",
+          url: "https://github.com/home-assistant/frontend",
+          directory: "website-cards",
+        },
+        files: ["frontend_latest", "static"],
+      },
+      null,
+      2
+    )
+  );
+  execFileSync("npm", ["pack", "--pack-destination", ".."], {
+    cwd: root,
+    stdio: "inherit",
+  });
+});
+
+gulp.task(
+  "build-website-cards",
+  gulp.series(
+    async function setEnv() {
+      process.env.NODE_ENV = "production";
+    },
+    createWorkflowLockTask("build-website-cards"),
+    "clean-website-cards",
+    gulp.parallel("gen-icons-json", "build-translations", "build-locale-data"),
+    "copy-static-website-cards",
+    "rspack-prod-website-cards",
+    "pack-website-cards"
+  )
+);
